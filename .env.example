# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# openssl rand -base64 32 — salts anonymous visitor hashes (src/lib/actor.ts)
BETTER_AUTH_SECRET=
# Public site origin, used by scripts/storage-setup.ts for CORS
BETTER_AUTH_URL=http://localhost:3000

# GDG auth service (gdg/auth-v2) — same setup as RADAR
AUTH_API_URL=http://localhost:8080
AUTH_COOKIE_NAME=gdg_token
AUTH_REFRESH_COOKIE_NAME=gdg_refresh_token

# Firebase web app config for the GDG project (Google + email/password sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Neon Object Storage — create the bucket in the Neon console (Storage), then
# a credential with storage:read + storage:write scopes (console > Credentials,
# or: neon credentials create --scope storage:read --scope storage:write).
# The endpoint is branch-specific; the console shows these values for whichever
# branch you're working against.
AWS_ENDPOINT_URL_S3=https://br-....storage.c-<n>.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...
AWS_REGION=us-east-2
S3_BUCKET=showcase-media

# openssl rand -base64 32 — checked against the Authorization header on the
# nightly signal-scoring cron route
CRON_SECRET=

# Upstash QStash signing keys — verify auth-v2's user.upsert events at
# /api/worker/auth-user. Add that URL to auth-v2's "user.upsert" URL group.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
